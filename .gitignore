# Foundry — anchored to the repo root, because a bare `lib/` also swallows web/lib,
# which is where the deployment addresses and the RPC fallback live.
/lib/
/out/
/cache/

# the official example repo, vendored read-only for reference and not our work
/examples/

node_modules/
.next/

# secrets: testnet burner key. never commit.
.env

# video intermediates — the built reel is committed, the frames that made it are not
/video/clips/
/video/segments/
/video/frames/raw/
/video/*.html
/.claude/

# build outputs
/web/out/

# internal working notes — build log, agent rules, review transcripts, superseded specs.
# they name competitors and judges; the public repo carries README.md as its documentation.
/CLAUDE.md
/PROGRESS.md
/SPEC.md
/SPEC-v1-폐기.md
/12칸-검토-종합.md
/실측-검증기록.md
